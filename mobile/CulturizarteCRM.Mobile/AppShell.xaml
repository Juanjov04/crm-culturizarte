<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CulturizarteCRM.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CulturizarteCRM.Mobile.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="CRM Culturizarte">

    <ShellContent
        Title="Iniciar sesión"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="login" />

    <!-- Barra inferior como en el prototipo (Figura 10). La pestaña de inventario llega en el Sprint 5. -->
    <TabBar Route="principal">
        <ShellContent
            Title="Inicio"
            Icon="tab_inicio.png"
            ContentTemplate="{DataTemplate views:InicioPage}"
            Route="inicio" />
        <ShellContent
            Title="Visitas"
            Icon="tab_visitas.png"
            ContentTemplate="{DataTemplate views:VisitasPage}"
            Route="visitas" />
    </TabBar>

</Shell>
