<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:CulturizarteCRM.Mobile.Models"
             x:Class="CulturizarteCRM.Mobile.Views.VisitasPage"
             Title="Mis visitas">
    <RefreshView x:Name="Refresco" Refreshing="OnRefrescar">
        <CollectionView x:Name="ListaVisitas" Margin="12">
            <CollectionView.EmptyView>
                <Label x:Name="VacioLabel" Text="Aún no has registrado visitas." HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:Visita">
                    <Border Margin="0,6" Padding="14" StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Detalle}" FontSize="14" />
                            <Label Text="{Binding FechaTexto}" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
