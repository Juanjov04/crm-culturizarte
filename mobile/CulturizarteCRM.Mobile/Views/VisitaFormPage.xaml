<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CulturizarteCRM.Mobile.Views.VisitaFormPage"
             BackgroundColor="{StaticResource Fondo}"
             Title="Nueva Visita B2B">

    <ContentPage.Resources>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource Borde}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="Paso" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.2" />
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
        </Style>
        <Style x:Key="Etiqueta" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource TextoSuave}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="14">
                <!-- Paso 1: selección del colegio y docente -->
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="PASO 1 · INSTITUCIÓN Y DOCENTE" Style="{StaticResource Paso}" />
                        <Label Text="Institución *" Style="{StaticResource Etiqueta}" />
                        <Picker x:Name="InstitucionPicker" Title="Selecciona la institución"
                                ItemDisplayBinding="{Binding Descripcion}"
                                SelectedIndexChanged="OnInstitucionCambiada" />
                        <Label Text="Docente visitado *" Style="{StaticResource Etiqueta}" />
                        <Picker x:Name="DocentePicker" Title="Selecciona el docente visitado"
                                ItemDisplayBinding="{Binding Descripcion}" IsEnabled="False"
                                SelectedIndexChanged="OnDocenteCambiado" />
                        <Label x:Name="SinDocentesLabel" Text="Esta institución no tiene docentes registrados."
                               IsVisible="False" FontSize="13" TextColor="#B45309" />
                    </VerticalStackLayout>
                </Border>

                <!-- Paso 2: resultado y acuerdos -->
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="PASO 2 · REGISTRO DE ACUERDOS" Style="{StaticResource Paso}" />
                        <!-- Observación del jurado: la visita se registra con la fecha y hora actual (no editable). -->
                        <!-- Observación del jurado: se puede elegir fecha y hora, pero nunca anteriores al registro. -->
                        <Label Text="Fecha y hora *" Style="{StaticResource Etiqueta}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <DatePicker x:Name="FechaPicker" Format="dd/MM/yyyy" DateSelected="OnFechaCambiada" />
                            <TimePicker x:Name="HoraPicker" Grid.Column="1" Format="HH:mm" PropertyChanged="OnHoraCambiada" />
                        </Grid>
                        <Label x:Name="FechaAyudaLabel" Text="Solo se permiten la fecha y hora actuales o posteriores." FontSize="11" TextColor="{StaticResource TextoSuave}" />
                        <Label Text="Nivel de interés *" Style="{StaticResource Etiqueta}" />
                        <Picker x:Name="InteresPicker" Title="Nivel de interés" />
                        <Label Text="Estado del docente frente a la adopción *" Style="{StaticResource Etiqueta}" />
                        <Picker x:Name="EstadoPicker" Title="Estado del docente" />
                        <Label Text="Acuerdos alcanzados *" Style="{StaticResource Etiqueta}" />
                        <Editor x:Name="AcuerdosEditor" Placeholder="Ej. Revisará muestras de Lengua 5.º EGB" AutoSize="TextChanges" MinimumHeightRequest="80" MaxLength="2000" />
                        <Label Text="Observaciones *" Style="{StaticResource Etiqueta}" />
                        <Editor x:Name="ObservacionesEditor" Placeholder="Observaciones" AutoSize="TextChanges" MinimumHeightRequest="80" MaxLength="2000" />
                    </VerticalStackLayout>
                </Border>

                <!-- Paso 3: asignación de muestras (Sprint 5, RF-03) -->
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="PASO 3 · ASIGNACIÓN DE MUESTRAS" Style="{StaticResource Paso}" />
                        <Label x:Name="MuestrasAyudaLabel" Text="Elige el docente para ver los textos compatibles con su área."
                               FontSize="13" TextColor="{StaticResource TextoSuave}" />
                        <VerticalStackLayout x:Name="MuestraForm" Spacing="4" IsVisible="False">
                            <Label Text="Texto escolar" Style="{StaticResource Etiqueta}" />
                            <Picker x:Name="ProductoPicker" Title="Selecciona el texto" ItemDisplayBinding="{Binding Descripcion}" />
                            <Label x:Name="CantidadLabel" Text="Cantidad: 1" Style="{StaticResource Etiqueta}" />
                            <Stepper x:Name="CantidadStepper" Minimum="1" Maximum="100" Value="1" Increment="1"
                                     ValueChanged="OnCantidadCambiada" />
                            <Button Text="+ Agregar muestra" Clicked="OnAgregarMuestra" Margin="0,6,0,0"
                                    BackgroundColor="{StaticResource Secondary}" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout x:Name="MuestrasLista" Spacing="6" Margin="0,6,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource Fondo}" Stroke="{StaticResource Borde}"
                                            StrokeShape="RoundRectangle 10" Padding="12,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Resumen}" FontSize="13" VerticalOptions="Center"
                                                   TextColor="{StaticResource TextoFuerte}" />
                                            <Button Grid.Column="1" Text="Quitar" Clicked="OnQuitarMuestra" FontSize="12"
                                                    Padding="10,0" HeightRequest="34" BackgroundColor="Transparent"
                                                    TextColor="{StaticResource Tertiary}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="ErrorLabel" TextColor="#B91C1C" IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="White" Stroke="{StaticResource Borde}" StrokeThickness="1" Padding="18,12,18,18">
            <VerticalStackLayout Spacing="8">
                <ActivityIndicator x:Name="Cargando" IsRunning="False" IsVisible="False" Color="{StaticResource Primary}" />
                <Button x:Name="GuardarButton" Text="Registrar visita" Clicked="OnGuardarClicked" HeightRequest="54" FontSize="16" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
