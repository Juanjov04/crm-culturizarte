<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CulturizarteCRM.Mobile.Views.VisitaFormPage"
             BackgroundColor="{StaticResource Fondo}"
             Title="Nueva Visita B2B">

    <ContentPage.Resources>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource Borde}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="Paso" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.2" />
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
        </Style>
        <Style x:Key="Etiqueta" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource TextoSuave}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="14">
                <!-- Paso 1: selección del colegio y docente -->
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="PASO 1 · INSTITUCIÓN Y DOCENTE" Style="{StaticResource Paso}" />
                        <Label Text="Institución" Style="{StaticResource Etiqueta}" />
                        <Picker x:Name="InstitucionPicker" Title="Selecciona la institución"
                                ItemDisplayBinding="{Binding Descripcion}"
                                SelectedIndexChanged="OnInstitucionCambiada" />
                        <Label Text="Docente visitado" Style="{StaticResource Etiqueta}" />
                        <Picker x:Name="DocentePicker" Title="Selecciona el docente visitado"
                                ItemDisplayBinding="{Binding Descripcion}" IsEnabled="False" />
                        <Label x:Name="SinDocentesLabel" Text="Esta institución no tiene docentes registrados."
                               IsVisible="False" FontSize="13" TextColor="#B45309" />
                    </VerticalStackLayout>
                </Border>

                <!-- Paso 2: datos de la visita -->
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="PASO 2 · DATOS DE LA VISITA" Style="{StaticResource Paso}" />
                        <Label Text="Fecha y hora" Style="{StaticResource Etiqueta}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <DatePicker x:Name="FechaPicker" Format="dd/MM/yyyy" />
                            <TimePicker x:Name="HoraPicker" Grid.Column="1" Format="HH:mm" />
                        </Grid>
                        <Label Text="Nivel de interés" Style="{StaticResource Etiqueta}" />
                        <Picker x:Name="InteresPicker" Title="Nivel de interés" />
                        <Label Text="Estado del docente frente a la adopción" Style="{StaticResource Etiqueta}" />
                        <Picker x:Name="EstadoPicker" Title="Estado del docente" />
                    </VerticalStackLayout>
                </Border>

                <!-- Paso 3: acuerdos y observaciones -->
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="PASO 3 · ACUERDOS Y OBSERVACIONES" Style="{StaticResource Paso}" />
                        <Label Text="Acuerdos alcanzados" Style="{StaticResource Etiqueta}" />
                        <Editor x:Name="AcuerdosEditor" Placeholder="Ej. Revisará muestras de Lengua 5.º EGB" AutoSize="TextChanges" MinimumHeightRequest="80" MaxLength="2000" />
                        <Label Text="Observaciones" Style="{StaticResource Etiqueta}" />
                        <Editor x:Name="ObservacionesEditor" Placeholder="Observaciones" AutoSize="TextChanges" MinimumHeightRequest="80" MaxLength="2000" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="ErrorLabel" TextColor="#B91C1C" IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="White" Stroke="{StaticResource Borde}" StrokeThickness="1" Padding="18,12,18,18">
            <VerticalStackLayout Spacing="8">
                <ActivityIndicator x:Name="Cargando" IsRunning="False" IsVisible="False" Color="{StaticResource Primary}" />
                <Button x:Name="GuardarButton" Text="Registrar visita" Clicked="OnGuardarClicked" HeightRequest="54" FontSize="16" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
