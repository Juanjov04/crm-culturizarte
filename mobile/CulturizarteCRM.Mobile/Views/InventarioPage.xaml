<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:CulturizarteCRM.Mobile.Models"
             x:Class="CulturizarteCRM.Mobile.Views.InventarioPage"
             BackgroundColor="{StaticResource Fondo}"
             Title="Mi inventario">
    <!-- Sprint 5 (CU-M03): stock de muestras del asesor y disponibilidad en bodega. -->
    <Grid RowDefinitions="Auto,*">
        <SearchBar x:Name="Buscador" Placeholder="Buscar por título o área"
                   TextChanged="OnBuscar" Margin="10,8,10,0" BackgroundColor="White" />

        <RefreshView Grid.Row="1" x:Name="Refresco" Refreshing="OnRefrescar" RefreshColor="{StaticResource Primary}">
            <CollectionView x:Name="ListaProductos" Margin="16,8">
                <CollectionView.EmptyView>
                    <Label x:Name="VacioLabel" Text="No hay textos en el catálogo." HorizontalOptions="Center"
                           TextColor="{StaticResource TextoSuave}" Margin="0,40" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Producto">
                        <Border Margin="0,6" Padding="16" StrokeShape="RoundRectangle 16"
                                BackgroundColor="White" Stroke="{StaticResource Borde}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                                <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="15"
                                       TextColor="{StaticResource TextoFuerte}" />
                                <Border Grid.Column="1" Padding="10,3" StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                        VerticalOptions="Start" BackgroundColor="{StaticResource ExitoFondo}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding SinStock}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#FEF2F2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding StockTexto}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Exito}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding SinStock}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Tertiary}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detalle}" FontSize="13"
                                       TextColor="{StaticResource TextoSuave}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding BodegaTexto}" FontSize="12" TextColor="#94A3B8" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
